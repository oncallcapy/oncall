---
import '../styles/global.css';
import '../styles/editorial-file.css';
import { ClientRouter } from 'astro:transitions';
import ChartHeader from '../components/ChartHeader.astro';
import CinematicStage from '../components/CinematicStage.astro';
import { PUBLIC_SOCIAL_LINKS } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'ONCALL',
  description = 'ONCALL night-shift case files: medicine, science and market culture.',
} = Astro.props;
const isOpening = (Astro.url.pathname.replace(/\/+$/, '') || '/') === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class:list={['site-shell', { 'site-shell--opening': isOpening }]}>
      {!isOpening && <ChartHeader />}
      <CinematicStage />
      <main id="main-content" class:list={['editorial-file', { 'editorial-file--opening': isOpening }]} data-file-content tabindex="-1">
        <slot />
        <footer class="editorial-file-footer meta">
          <span>ONCALL / Evidence first. Memes after rounds.</span>
          <span>Night-shift records room</span>
          <nav class="editorial-file-footer__links" aria-label="ONCALL on the web">
            {PUBLIC_SOCIAL_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
          </nav>
        </footer>
      </main>
    </div>
  </body>
</html>
