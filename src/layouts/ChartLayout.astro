---
import '../styles/global.css';
import ChartHeader from '../components/ChartHeader.astro';
import FileTabs from '../components/FileTabs.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'ONCALL',
  description = 'ONCALL night-shift case files: medicine, science and market culture. Launch pending.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="chart">
      <ChartHeader />
      <FileTabs />
      <main id="main-content" class="chart-content" tabindex="-1">
        <slot />
        <footer class="chart-footer meta">
          <span>ONCALL / Evidence first. Memes after rounds.</span>
          <span>Pre-launch file · Working identity</span>
        </footer>
      </main>
    </div>
  </body>
</html>
