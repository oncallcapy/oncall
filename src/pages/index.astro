---
import ChartLayout from '../layouts/ChartLayout.astro';
import FolderMascotCallout from '../components/FolderMascotCallout.astro';
---

<ChartLayout>
  <section class="triage-hero" aria-labelledby="oncall-title">
    <p class="eyebrow">MEDICINE / SCIENCE / MARKET CULTURE</p>
    <h1 id="oncall-title">ONCALL</h1>
    <p class="hero-line">NIGHT SHIFT FOR THE TERMINALLY ONLINE.</p>
    <p class="status-line">STATUS / ON SHIFT</p>
  </section>
  <p class="hero-intro">Science gets its sources. Markets get their context. The mascot gets the late shift.</p>
  <section class="intake-note" aria-labelledby="intake-heading">
    <h2 id="intake-heading" class="meta">Intake note</h2>
    <p>Open a file for sourced science, market context, original night-shift humour, and the project record.</p>
  </section>
  <FolderMascotCallout file="triage" />
</ChartLayout>

<style>
  .triage-hero { position: absolute; z-index: 3; top: 6cqw; left: 6cqw; width: 45cqw; color: var(--paper-raised); }
  .eyebrow { margin-bottom: 1rem; font-family: var(--font-meta); font-size: clamp(0.55rem, 0.8cqw, 0.75rem); letter-spacing: 0.06em; line-height: 1.5; }
  h1 { font-size: 10cqw; font-weight: 900; letter-spacing: -0.04em; line-height: 0.95; }
  .hero-line { max-width: 38cqw; margin-top: 1rem; font-family: var(--font-display); font-size: 3.2cqw; font-weight: 750; line-height: 1.08; letter-spacing: -0.02em; }
  .status-line { display: inline-block; margin-top: 1.25rem; color: var(--coral); font-family: var(--font-meta); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; }
  .hero-intro { max-width: 44rem; margin-bottom: 2rem; font-size: 1.2rem; }
  .intake-note { display: grid; grid-template-columns: 7rem 1fr; gap: 1.5rem; padding-block: 1rem; border-block: 1px solid var(--rule); }
  .intake-note h2 { padding-top: 0.3rem; font-weight: 400; }
  .intake-note p { max-width: 40rem; font-size: 1.1rem; }
  @media (max-width: 47.999rem) {
    .triage-hero { top: 5cqw; left: 6cqw; width: 45cqw; }
    h1 { font-size: 13cqw; }
    .eyebrow { font-size: 0.55rem; margin-bottom: 0.6rem; }
    .hero-line { max-width: 45cqw; font-size: 5.5cqw; margin-top: 0.6rem; }
    .status-line { margin-top: 0.8rem; font-size: 0.6rem; }
    .intake-note { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
  }
</style>
