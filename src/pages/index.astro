---
import ChartLayout from '../layouts/ChartLayout.astro';
---

<ChartLayout>
  <section class="triage-hero" aria-labelledby="oncall-title">
    <p class="eyebrow">MEDICINE / SCIENCE / MARKET CULTURE</p>
    <h1 id="oncall-title">ONCALL</h1>
    <p class="hero-line">NIGHT SHIFT FOR THE TERMINALLY ONLINE.</p>
    <p class="status-line">STATUS / ON SHIFT</p>
    <p class="hero-intro">Science gets its sources. Markets get their context. The mascot gets the late shift.</p>
  </section>
  <section class="intake-note" aria-labelledby="intake-heading">
    <h2 id="intake-heading" class="meta">Intake note</h2>
    <p>Open a file for sourced science, market context, original night-shift humour, and the project record.</p>
  </section>
</ChartLayout>

<style>
  .triage-hero { padding-block: clamp(1rem, 4vw, 3rem) 2.5rem; }
  .eyebrow { margin-bottom: 0.8rem; color: var(--ink); font-family: var(--font-meta); font-size: 0.6875rem; letter-spacing: 0.075em; line-height: 1.6; }
  h1 { font-size: clamp(4.5rem, 8.8vw, 8.75rem); font-weight: 900; letter-spacing: -0.055em; line-height: 0.95; }
  .hero-line { max-width: 32rem; margin-top: 1.5rem; font-family: var(--font-display); font-size: clamp(2rem, 3.2vw, 3rem); font-weight: 750; line-height: 1.06; letter-spacing: -0.025em; }
  .status-line { display: inline-block; margin-top: 1.5rem; padding: 0.45rem 0.65rem; background: var(--coral); color: var(--ink); font-family: var(--font-meta); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; }
  .hero-intro { max-width: 38rem; margin-top: 1.5rem; font-size: 1.125rem; }
  .intake-note { display: grid; grid-template-columns: 7rem 1fr; gap: 1.5rem; padding-block: 1rem; border-block: 1px solid var(--rule); }
  .intake-note h2 { padding-top: 0.3rem; font-weight: 400; }
  .intake-note p { max-width: 35rem; font-size: 1.1rem; }
  @media (max-width: 47.999rem) {
    h1 { font-size: clamp(4.5rem, 18vw, 7rem); }
    .intake-note { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
  }
</style>
