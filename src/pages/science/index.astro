---
import { getCollection } from 'astro:content';
import ChartLayout from '../../layouts/ChartLayout.astro';
import ScienceNoteCard from '../../components/ScienceNoteCard.astro';
import { SCIENCE_THEMES } from '../../config/scienceThemes';
const notes = (await getCollection('science')).sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));
---

<ChartLayout title="Science Notes | ONCALL" description="Evidence-based medicine, transparent sources and explicit limits. Science Notes from ONCALL.">
  <p class="meta">Case file 05 / Evidence desk</p>
  <h1>Science Notes</h1>
  <p class="intro">Evidence-based medicine, with the sources open and the limits visible.</p>
  <p>Educational notes require human review of the evidence before publication. A valid content structure does not establish scientific truth. These notes do not provide diagnosis or treatment advice.</p>
  <p class="program">The program follows five selected-pair research domains. See the <a href="/pairs/">exact market-to-domain map</a> for the editorial associations. Article titles, claims and conclusions stay brand-neutral and source-led; these associations imply no sponsorship, endorsement, clinical validation, or investment analysis.</p>
  <section aria-labelledby="themes-heading">
    <h2 id="themes-heading">Clinical themes</h2>
    <ul class="themes">{Object.values(SCIENCE_THEMES).map((label) => <li>{label}</li>)}</ul>
  </section>
  {notes.length > 0 && <section aria-labelledby="notes-heading">
    <h2 id="notes-heading">Science dossiers</h2>
    {notes.map((note) => <ScienceNoteCard note={note} />)}
  </section>}
  <p class="routing">Looking for company identities or company-specific reporting? Open <a href="/pairs/">FIVE PAIRS</a> or <a href="/market-rounds/">MARKET ROUNDS</a>.</p>
</ChartLayout>

<style>
  h1 { margin-block: 0.75rem 1.25rem; font-size: clamp(2.6rem, 6vw, 5rem); }
  .program { margin-top: 1rem; }
  .intro { font-size: 1.4rem; margin-bottom: 1rem; }
  section { margin-top: 2.5rem; }
  h2 { font-size: 1.6rem; margin-bottom: 1rem; }
  .themes { padding-left: 1.3rem; }
  .themes li + li { margin-top: 0.4rem; }
  .routing { margin-top: 2rem; }
</style>
