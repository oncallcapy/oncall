---
import type { CollectionEntry } from 'astro:content';
import { SCIENCE_THEMES } from '../config/scienceThemes';
interface Props { note: CollectionEntry<'science'>; }
const { note } = Astro.props;
const href = `/science/${note.id.split('/').map(encodeURIComponent).join('/')}/`;
---

<article class="science-card">
  <p class="meta"><time datetime={note.data.publishedAt}>{note.data.publishedAt}</time> / Science Note</p>
  <h3><a href={href}>{note.data.title}</a></h3>
  <p>{note.data.summary}</p>
  <ul class="meta" aria-label="Clinical themes">
    {note.data.themes.map((theme) => <li>{SCIENCE_THEMES[theme]}</li>)}
  </ul>
</article>

<style>
  .science-card { padding-block: 1.5rem; border-top: 1px solid var(--rule); }
  h3 { margin-block: 0.65rem; font-size: 1.7rem; line-height: 1.15; }
  ul { padding-left: 1rem; margin-bottom: 0; }
</style>
