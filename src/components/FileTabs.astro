---
import { NAV_ITEMS } from '../config/navigation';

interface Props { currentPath?: string; }
const { currentPath = Astro.url.pathname } = Astro.props;
const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const normalizedPath = normalizePath(currentPath);
const isActive = (href: string) => {
  const route = normalizePath(href);
  return normalizedPath === route || (route !== '/' && normalizedPath.startsWith(`${route}/`));
};
---

<nav class="file-tabs" aria-label="Case files">
  <ol>
    {NAV_ITEMS.map((item) => (
      <li>
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          <span class="file-number" aria-hidden="true">{item.shortLabel}</span>
          <span class="file-label">{item.label}</span>
          {isActive(item.href) && <span class="active-mark" aria-hidden="true">←</span>}
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .file-tabs { grid-column: 2; grid-row: 2; position: sticky; top: 1rem; padding-top: 1.5rem; }
  ol { margin: 0; padding: 0; list-style: none; }
  li + li { margin-top: 0.4rem; }
  a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 4rem;
    padding: 0.875rem 0.75rem;
    border: 1px solid var(--ink);
    border-left: 0;
    border-radius: 0 0.45rem 0.45rem 0;
    background: var(--paper-edge);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 160ms ease;
  }
  a:hover { background: var(--paper-raised); }
  a:focus-visible { z-index: 1; outline: 3px solid var(--coral); outline-offset: 2px; }
  a[aria-current='page'] {
    margin-left: -1px;
    border-left: 4px solid var(--coral);
    background: var(--paper);
  }
  a[aria-current='page'] .file-label { text-decoration: underline; text-underline-offset: 0.22em; }
  .file-number { font-family: var(--font-meta); font-size: 0.625rem; }
  .file-label { font-family: var(--font-display); font-size: 0.95rem; font-weight: 750; line-height: 1.2; }
  .active-mark { margin-left: auto; font-family: var(--font-meta); font-size: 1rem; }
  @media (max-width: 47.999rem) {
    .file-tabs {
      position: static;
      grid-column: 1;
      grid-row: 2;
      min-width: 0;
      padding: 0.375rem 0.25rem 0;
      overflow-x: auto;
    }
    ol { display: flex; gap: 0.35rem; padding: 0.25rem 0.25rem 0.5rem; }
    li { flex: 0 0 auto; }
    li + li { margin-top: 0; }
    a { min-height: 3rem; border: 1px solid var(--ink); border-radius: 0.4rem 0.4rem 0 0; white-space: nowrap; }
    a[aria-current='page'] { margin-left: 0; border-left: 1px solid var(--ink); border-bottom: 4px solid var(--coral); }
    .active-mark { display: none; }
  }
</style>
