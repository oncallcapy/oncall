---
import type { SelectedPair } from '../data/pairSelections';
import { SCIENCE_THEMES } from '../config/scienceThemes';
interface Props { pair: SelectedPair; index: number; }
const { pair, index } = Astro.props;
---
<article class="pair-case" data-pair-record aria-labelledby={`pair-${pair.symbol}`}>
  <header>
    <p class="meta">Selected pair {String(index + 1).padStart(2, '0')} / Quote identity</p>
    <h2 id={`pair-${pair.symbol}`}>{pair.symbol} <span>{pair.displayName}</span></h2>
    <p class="theme">Theme / {SCIENCE_THEMES[pair.scienceTheme]}</p>
    <p class="research-track"><strong>Science research track</strong><br />{pair.researchTrack}</p>
  </header>
  <dl>
    <div><dt>Project selection</dt><dd><strong>{pair.selectionStatus.toUpperCase()}</strong></dd></div>
    <div><dt>Official API observation</dt><dd><strong>ACTIVE</strong> / ASSET_STATUS_ACTIVE · Chain 4663</dd></div>
    <div><dt>Observed at (UTC)</dt><dd><time datetime={pair.observedAt}>{pair.observedAt}</time></dd></div>
    <div><dt>Robinhood Chain contract</dt><dd class="address">{pair.robinhoodContract}</dd></div>
  </dl>
  <p class="risk"><span class="meta">Boundary note</span>{pair.riskNote}</p>
  <p class="links"><a href={pair.sourceUrl}>Official asset API ↗</a><a href={`https://robinhoodchain.blockscout.com/address/${pair.robinhoodContract}`}>Inspect quote contract ↗</a></p>
</article>
<style>
  .pair-case { position: relative; margin-top: 2rem; border: 1px solid var(--ink); border-left: 0.55rem solid var(--teal); padding: clamp(1.1rem, 3vw, 2rem); background: var(--paper-raised); box-shadow: 0.35rem 0.35rem 0 color-mix(in srgb, var(--fur) 42%, transparent); }
  .pair-case:nth-of-type(even) { border-left-color: var(--coral); }
  h2 { font-size: 2.7rem; margin-block: 0.6rem 0.75rem; }
  h2 span { display: block; font-size: 1.35rem; line-height: 1.15; margin-top: 0.3rem; }
  .theme, .risk, .research-track { font-size: 1rem; }
  dl { font-family: var(--font-meta); font-size: 0.72rem; line-height: 1.6; margin-block: 1.25rem; }
  dl > div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr); gap: 0.4rem 1rem; padding-block: 0.6rem; border-top: 1px solid var(--rule); }
  dt { color: var(--muted-ink); }
  dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .risk { border-left: 2px solid var(--coral); padding-left: 0.8rem; }
  .risk .meta { display: block; margin-bottom: 0.25rem; color: var(--muted-ink); }
  .links { display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; margin-top: 1rem; font-size: 0.9rem; }
  @media (max-width: 35rem) { dl > div { grid-template-columns: minmax(0, 1fr); } }
</style>
